{
  "name": "@mcp-web/tools",
  "version": "0.2.0",
  "description": "MCP Web tools collection",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./code": {
      "import": "./dist/code/index.js",
      "types": "./dist/code/index.d.ts"
    },
    "./code/worker": {
      "import": "./dist/code/worker-executor.js",
      "types": "./dist/code/worker-executor.d.ts"
    },
    "./python": {
      "import": "./dist/python/index.js",
      "types": "./dist/python/index.d.ts"
    },
    "./dom": {
      "import": "./dist/dom/index.js",
      "types": "./dist/dom/index.d.ts"
    },
    "./screenshot": {
      "import": "./dist/screenshot/index.js",
      "types": "./dist/screenshot/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mcp-web/types": "workspace:*",
    "acorn": "^8.14.0",
    "html-to-image": "^1.11.13",
    "uuid": "^14.0.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flekschas/mcp-web",
    "directory": "packages/tools"
  }
}
