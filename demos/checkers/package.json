    "@ai-sdk/provider": "^4.0.39",
    "@hono/node-server": "^1.19.19",
    "@mcp-web/bridge": "workspace:*",
    "@mcp-web/client": "workspace:*",
    "@mcp-web/core": "workspace:*",
    "@mcp-web/types": "workspace:*",
    "ai": "^7.0.179",
    "dotenv": "^17.4.2",
    "hono": "^4.13.19",
    "uuid": "^13.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "catalog:",
    "@tsconfig/svelte": "^5.0.9",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "concurrently": "catalog:",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "svelte-eslint-parser": "^1.10.1",
    "tailwindcss": "catalog:",
    "tslib": "^2.9.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.73.0",
    "vite": "catalog:"
  }
