{
  "name": "@mcp-web/demos/checkers",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:app\" \"pnpm run dev:agent\" \"pnpm run dev:bridge\"",
    "dev:app": "vite",
    "dev:agent": "tsx watch serve-agent.ts",
    "dev:bridge": "tsx watch bridge.ts",
    "bridge": "tsx bridge.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.svelte\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.107",
    "@ai-sdk/cerebras": "^3.0.95",
